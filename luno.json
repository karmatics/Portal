{
  "name": "Portal",
  "version": "2.0.0",
  "description": "Single-Page Public Portal, Global Partial Document Composer, In-Place Sibling SPA Router & Comments Hub",
  "type": "luno-web-app",
  "mainClass": "Portal",
  "entrypoint": {
    "file": "Portal.js",
    "class": "Portal",
    "method": "run"
  },
  "main": [
    "js/PortalData.js",
    "js/PortalSummaryEngine.js",
    "js/PortalContentExtractor.js",
    "js/PortalPromptBuilder.js",
    "js/PortalDocContent.js",
    "js/PortalModals.js",
    "Portal.js"
  ],
  "library": [
    "DomBasics.js",
    "UITools.js",
    "GlowingTooltip.js",
    "DictationWidget.js",
    "SidePanel.js",
    "CommunityOracle.js",
    "SupabaseCommentsAdapter.js",
    "CadPlanDataRegistry.js",
    "CadPlanItemNotes.js",
    "CadPlanDocumentEditor.js",
    "CadPlanAardvark.js",
    "SensitiveContextGate.js",
    "PartialDocumentEngine.js",
    "DocumentReader.js"
  ],
  "styles": [
    "portal.css"
  ],
  "visibilitySets": {
    "frontpage-core": [
      "Portal/Portal.js",
      "Portal/js/PortalData.js",
      "Portal/js/PortalPromptBuilder.js",
      "Portal/js/PortalContentExtractor.js",
      "Portal/js/PortalModals.js",
      "Portal/portal.css",
      "Portal/luno.json"
    ],
    "partial-engine": [
      "Library/PartialDocumentEngine.js",
      "Portal/js/PortalPromptBuilder.js",
      "Portal/js/PortalContentExtractor.js"
    ],
    "summary-engine": [
      "Portal/js/PortalSummaryEngine.js",
      "Portal/js/PortalData.js",
      "Portal/state/summaries.json"
    ],
    "doc-integration": [
      "Portal/js/PortalDocContent.js",
      "Portal/Portal.js",
      "Library/DocumentReader.js",
      "Library/SensitiveContextGate.js"
    ]
  }
}